    "You only granted Unrolled access to a selection of photos. Pick more to continue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منحت Unrolled الوصول إلى مجموعة محددة من الصور فقط. اختر المزيد للمتابعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি Unrolled-কে শুধু কিছু নির্বাচিত ছবি দেখার অনুমতি দিয়েছেন। চালিয়ে যেতে আরও ছবি বেছে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Unrolled nur Zugriff auf eine Auswahl von Fotos gegeben. Wähle weitere aus, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo has dado a Unrolled acceso a una selección de fotos. Elige más para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as autorisé Unrolled à ne voir qu'une sélection de photos. Choisis-en d'autres pour continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने Unrolled को सिर्फ़ कुछ चुनी हुई फ़ोटो देखने की अनुमति दी है। जारी रखने के लिए और फ़ोटो चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu hanya memberi Unrolled akses ke sebagian foto. Pilih lebih banyak untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dato a Unrolled l'accesso solo a una selezione di foto. Scegline altre per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolledには一部の写真へのアクセスのみが許可されています。続けるには、さらに写真を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled에 일부 사진에 대한 접근만 허용했습니다. 계속하려면 사진을 더 선택하세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही Unrolled ला फक्त निवडक फोटो पाहण्याची परवानगी दिली आहे. पुढे जाण्यासाठी आणखी फोटो निवडा."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt Unrolled alleen toegang gegeven tot een selectie foto's. Kies er meer om verder te gaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você só deu ao Unrolled acesso a uma seleção de fotos. Escolha mais para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled получил доступ только к выбранным фото. Выбери ещё, чтобы продолжить."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சில புகைப்படங்களுக்கு மட்டுமே Unrolled-க்கு அணுகல் கொடுத்துள்ளீர்கள். தொடர மேலும் சிலவற்றைத் தேர்ந்தெடுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు Unrolledకు కొన్ని ఫోటోలకు మాత్రమే యాక్సెస్ ఇచ్చారు. కొనసాగించడానికి మరిన్ని ఎంచుకోండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled'a yalnızca seçtiğin fotoğraflar için erişim verdin. Devam etmek için daha fazlasını seç."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ نے Unrolled کو صرف چند منتخب تصاویر تک رسائی دی ہے۔ جاری رکھنے کے لیے مزید تصاویر منتخب کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chỉ cho Unrolled truy cập một số ảnh đã chọn. Hãy chọn thêm để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你只允许 Unrolled 访问部分照片。请选择更多照片以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你只允許 Unrolled 存取部分照片。請選取更多照片以繼續。"
          }
        }
      }
    },
    "Your gallery is waiting: %lld photos today?" : {
      "localizations" : {
