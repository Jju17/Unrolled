    "Unrolled needs permission to read your photos so you can swipe through them." : {
      "comment" : "Permission gate body copy",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Unrolled إلى إذن لقراءة صورك لتتمكن من تصفحها بالسحب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled-এর আপনার ছবি পড়ার অনুমতি দরকার, যাতে আপনি সোয়াইপ করে সেগুলো দেখতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled braucht die Berechtigung, deine Fotos zu lesen, damit du sie durchwischen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled necesita permiso para leer tus fotos y que puedas recorrerlas deslizando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled a besoin d'accéder à tes photos pour que tu puisses les parcourir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled को आपकी फ़ोटो पढ़ने की अनुमति चाहिए, ताकि आप उन्हें स्वाइप करके देख सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled perlu izin membaca fotomu agar kamu bisa menggesernya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled ha bisogno del permesso di leggere le tue foto perché tu possa sfogliarle con uno swipe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真をスワイプで見ていけるように、Unrolledに写真の読み取りを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 스와이프하며 넘겨볼 수 있도록 Unrolled에 사진 읽기 권한이 필요합니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled ला तुमचे फोटो वाचण्याची परवानगी लागते, म्हणजे तुम्ही ते स्वाइप करून पाहू शकाल."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled heeft toestemming nodig om je foto's te lezen zodat je erdoorheen kunt swipen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Unrolled precisa de permissão para ler suas fotos para que você possa deslizar por elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled нужно разрешение на чтение твоих фото, чтобы их можно было листать."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் ஸ்வைப் செய்து பார்க்க, உங்கள் புகைப்படங்களைப் படிக்க Unrolled-க்கு அனுமதி தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు స్వైప్ చేస్తూ చూసేందుకు Unrolledకు మీ ఫోటోలను చదివే అనుమతి అవసరం."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled'ın fotoğraflarını kaydırarak gezebilmen için onları okuma izni gerekiyor."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled کو آپ کی تصاویر پڑھنے کی اجازت چاہیے تاکہ آپ انہیں سوائپ کر کے دیکھ سکیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled cần quyền đọc ảnh của bạn để bạn có thể vuốt qua chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled 需要读取照片的权限，这样你才能滑动浏览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unrolled 需要讀取照片的權限，你才能滑動瀏覽。"
          }
        }
      }
    },
