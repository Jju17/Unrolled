        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجمع اللقطات المتشابهة الملتقطة بفارق ثوانٍ لتحتفظ بأفضلها. يعمل الاكتشاف على جهازك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কয়েক সেকেন্ডের ব্যবধানে তোলা একই রকম ছবি একসাথে দেখানো হয়, যাতে আপনি সেরাটি রাখতে পারেন। শনাক্তকরণ আপনার ডিভাইসেই হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ähnliche Aufnahmen, die nur Sekunden auseinanderliegen, werden gruppiert, damit du die beste behältst. Die Erkennung läuft auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tomas similares hechas con segundos de diferencia se agrupan para que conserves la mejor. La detección se hace en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos prises à quelques secondes d'intervalle sont regroupées pour garder la meilleure. La détection se fait sur ton appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ सेकंड के अंतर पर ली गई मिलती-जुलती फ़ोटो एक साथ दिखती हैं, ताकि आप सबसे अच्छी वाली रखें। पहचान आपके डिवाइस पर ही होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jepretan serupa yang diambil berselang beberapa detik dikelompokkan agar kamu bisa menyimpan yang terbaik. Deteksi berjalan di perangkatmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli scatti simili fatti a pochi secondi di distanza vengono raggruppati così tieni il migliore. Il rilevamento avviene sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数秒以内に撮った似た写真をまとめて、いちばん良い1枚を残せます。検出は端末内で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 초 간격으로 찍은 비슷한 사진을 묶어서 가장 좋은 한 장만 남길 수 있습니다. 감지는 기기에서 이루어집니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काही सेकंदांच्या अंतराने काढलेले सारखे फोटो एकत्र दाखवले जातात, म्हणजे तुम्ही सर्वोत्तम ठेवू शकाल. ओळख तुमच्या डिव्हाइसवरच होते."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijkbare foto's die seconden na elkaar zijn gemaakt, worden gegroepeerd zodat je de beste bewaart. De herkenning gebeurt op je toestel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos parecidas tiradas com segundos de diferença são agrupadas para você ficar com a melhor. A detecção roda no seu aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похожие кадры, снятые с разницей в секунды, группируются, чтобы оставить лучший. Распознавание работает на твоём устройстве."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சில நொடிகள் இடைவெளியில் எடுத்த ஒத்த படங்கள் குழுவாக்கப்படும், சிறந்ததை வைத்திருக்கலாம். கண்டறிதல் உங்கள் சாதனத்திலேயே நடக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కొన్ని సెకన్ల తేడాతో తీసిన ఒకేలాంటి షాట్‌లను గ్రూప్ చేస్తుంది, మీరు ఉత్తమమైనదాన్ని ఉంచుకోవచ్చు. గుర్తింపు మీ పరికరంలోనే జరుగుతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saniyeler arayla çekilen benzer kareler gruplanır, en iyisini saklarsın. Algılama cihazında çalışır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چند سیکنڈ کے فرق سے لی گئی ملتی جلتی تصاویر ایک ساتھ دکھائی جاتی ہیں تاکہ آپ بہترین رکھ سکیں۔ پہچان آپ کے ڈیوائس پر ہی ہوتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ảnh tương tự chụp cách nhau vài giây được gom lại để bạn giữ ảnh đẹp nhất. Việc phát hiện chạy ngay trên thiết bị của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "几秒内连拍的相似照片会归为一组，方便你只留最好的一张。检测在你的设备上完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幾秒內連拍的相似照片會歸為一組，方便你只留最好的一張。偵測在你的裝置上完成。"
          }
        }
      }
    },
