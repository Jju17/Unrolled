    "Choose which info to show on each photo, and whether Live Photos play automatically when viewed full-screen." : {
      "comment" : "A description of the settings available in the settings sheet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر المعلومات التي تظهر على كل صورة، وما إذا كانت Live Photos تُشغّل تلقائيًا عند عرضها بملء الشاشة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি ছবিতে কোন তথ্য দেখাবে তা বেছে নিন, আর ফুল স্ক্রিনে দেখার সময় Live Photos আপনা-আপনি চলবে কি না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, welche Infos auf jedem Foto angezeigt werden und ob Live Photos im Vollbild automatisch abgespielt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué información mostrar en cada foto y si las Live Photos se reproducen automáticamente a pantalla completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis les infos affichées sur chaque photo, et si les Live Photos se lancent automatiquement en plein écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि हर फ़ोटो पर कौन सी जानकारी दिखे, और फ़ुल स्क्रीन में देखने पर Live Photos अपने आप चलें या नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih info yang ditampilkan di setiap foto, dan apakah Live Photos diputar otomatis saat dilihat layar penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quali informazioni mostrare su ogni foto e se le Live Photos partono da sole a schermo intero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各写真に表示する情報と、全画面表示でLive Photosを自動再生するかどうかを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 사진에 표시할 정보와 전체 화면에서 Live Photo를 자동 재생할지 선택하세요."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक फोटोवर कोणती माहिती दाखवायची ते निवडा, आणि फुल स्क्रीनमध्ये पाहताना Live Photos आपोआप चालावेत का तेही."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies welke info je op elke foto ziet en of Live Photos automatisch afspelen op volledig scherm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quais informações mostrar em cada foto e se as Live Photos tocam automaticamente em tela cheia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери, какие данные показывать на каждом фото и воспроизводить ли Live Photos автоматически на весь экран."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு புகைப்படத்திலும் எந்தத் தகவலைக் காட்ட வேண்டும், முழுத்திரையில் பார்க்கும்போது Live Photos தானாக இயங்க வேண்டுமா என்பதைத் தேர்வு செய்யுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతి ఫోటోపై ఏ సమాచారం చూపించాలో, మరియు పూర్తి స్క్రీన్‌లో చూసినప్పుడు Live Photos ఆటోమేటిక్‌గా ప్లే కావాలో ఎంచుకోండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her fotoğrafta hangi bilgilerin gösterileceğini ve Live Photos'ların tam ekranda otomatik oynatılıp oynatılmayacağını seç."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منتخب کریں کہ ہر تصویر پر کون سی معلومات دکھائی جائیں، اور فل اسکرین میں دیکھتے وقت Live Photos خود بخود چلیں یا نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn thông tin hiển thị trên mỗi ảnh, và Live Photos có tự động phát khi xem toàn màn hình hay không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择每张照片上显示的信息，以及全屏查看时是否自动播放 Live Photos。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇每張照片上要顯示的資訊，以及全螢幕檢視時是否自動播放 Live Photos。"
          }
        }
      }
    },
    "Clears every kept/deleted marker so the deck shows the full library again. The photos themselves are untouched." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح كل علامات الاحتفاظ/الحذف لتعرض الرزمة المكتبة كاملة من جديد. الصور نفسها لا تُمس."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রাখা/মোছার সব চিহ্ন মুছে যায়, যাতে ডেকে আবার পুরো লাইব্রেরি দেখা যায়। ছবিগুলো নিজে অক্ষত থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle Behalten/Löschen-Markierungen, damit das Deck wieder die ganze Mediathek zeigt. Die Fotos selbst bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra todas las marcas de conservada/eliminada para que el mazo vuelva a mostrar toda la fototeca. Las fotos en sí no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface tous les marqueurs gardé/supprimé pour que le paquet affiche à nouveau toute la photothèque. Les photos elles-mêmes ne sont pas touchées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रखी/हटाई गई हर निशानी मिट जाएगी, ताकि डेक में फिर से पूरी लाइब्रेरी दिखे। फ़ोटो खुद जैसी की तैसी रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus semua tanda simpan/hapus sehingga dek menampilkan seluruh galeri lagi. Fotonya sendiri tidak disentuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella tutti i contrassegni tenuta/eliminata così il mazzo mostra di nuovo tutta la libreria. Le foto in sé non vengono toccate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残す/削除のマークをすべて消去し、デッキにライブラリ全体を再表示します。写真そのものは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남김/삭제 표시를 모두 지우고 덱에 전체 사진 보관함을 다시 표시합니다. 사진 자체는 그대로 유지됩니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठेवले/हटवले अशा सगळ्या खुणा पुसल्या जातात, म्हणजे डेकमध्ये पुन्हा पूर्ण लायब्ररी दिसते. फोटो स्वतः जसेच्या तसे राहतात."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist alle bewaard/verwijderd-markeringen zodat het deck weer de hele bibliotheek toont. De foto's zelf blijven onaangeroerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as marcações de mantida/excluída para que o baralho mostre a biblioteca inteira de novo. As fotos em si não são alteradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стирает все отметки «оставить/удалить», и колода снова показывает всю библиотеку. Сами фото не затрагиваются."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வைத்திருந்த/நீக்கிய குறிகள் அனைத்தையும் அழிக்கும், டெக் மீண்டும் முழு லைப்ரரியையும் காட்டும். புகைப்படங்கள் அப்படியே இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఉంచిన/తొలగించిన గుర్తులన్నీ తొలగిస్తుంది, డెక్ మళ్లీ పూర్తి లైబ్రరీని చూపిస్తుంది. ఫోటోలు మాత్రం అలాగే ఉంటాయి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm saklandı/silindi işaretlerini temizler, deste yeniden tüm kitaplığı gösterir. Fotoğrafların kendisine dokunulmaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رکھی/حذف شدہ ہر نشانی مٹ جاتی ہے تاکہ ڈیک میں دوبارہ پوری لائبریری نظر آئے۔ تصاویر خود جوں کی توں رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mọi đánh dấu giữ/xóa để bộ thẻ hiển thị lại toàn bộ thư viện. Bản thân các ảnh không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除所有保留/删除标记，让卡组重新显示整个图库。照片本身不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除所有保留/刪除標記，讓卡組重新顯示整個圖庫。照片本身不受影響。"
          }
        }
      }
    },
